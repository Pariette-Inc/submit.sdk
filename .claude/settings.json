{
  "permissions": {
    "deny": [
      "Bash(git push origin live:*)",
      "Bash(git push origin HEAD:live:*)",
      "Bash(git push origin test:live:*)",
      "Bash(git push -u origin live:*)",
      "Bash(git push origin main:*)",
      "Bash(git push origin HEAD:main:*)",
      "Bash(git push origin test:main:*)",
      "Bash(git push -u origin main:*)",
      "Bash(git push origin test --force:*)",
      "Bash(git push origin test -f:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push origin --force:*)",
      "Bash(git push origin -f:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git push origin +*)",
      "Bash(gh pr merge:*)"
    ],
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git fetch:*)",
      "Bash(git branch:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr view:*)",
      "Bash(submit status:*)",
      "Bash(submit check:*)",
      "Bash(submit note:*)",
      "Bash(git push origin test:*)",
      "Bash(git push -u origin test:*)",
      "Bash(gh pr create --base live --head test:*)",
      "Bash(gh pr edit:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git push*)",
            "command": "\"$CLAUDE_PROJECT_DIR/../submitcms/bin/hooks/guard-push.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/../submitcms/bin/hooks/sync-status.sh\" --json 2>/dev/null || true",
            "timeout": 25,
            "statusMessage": "Git senkron durumu kontrol ediliyor..."
          }
        ]
      }
    ]
  }
}
