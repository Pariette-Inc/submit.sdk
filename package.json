{
  "name": "submit-sdk-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "spec:generate": "node scripts/generate-spec.mjs",
    "build": "pnpm --filter @submitcms/sdk build",
    "typecheck": "pnpm -r typecheck",
    "test:contract": "pnpm --filter @submitcms/contract-tests test",
    "docs:generate": "node scripts/generate-reference.mjs",
    "docs:publish": "node scripts/generate-reference.mjs --out ../submit.web/src/data/sdk-reference.json"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
